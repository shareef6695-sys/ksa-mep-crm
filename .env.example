# =====================================================================
# Template only: copy to .env and fill in. .env is git-ignored. Never commit real values.
# =====================================================================

# --- Browser (compiled into the public bundle; also set in Vercel -> Settings -> Environment Variables) ---
# Only these two VITE_ variables are allowed; the build refuses anything that looks like a secret.
# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase -> Project Settings -> API -> anon / publishable key. Public by design: Row Level Security protects the data.
# NEVER the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Local scripts only (set in your terminal for the one command, then clear it; not used by the app) ---
# scripts/apply-migrations.mjs: Supabase -> Connect -> Session pooler string, with the DB password
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- End-to-end tests against a LOCAL stack only (e2e/seed.mjs refuses anything but localhost) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=local-stack-service-role-key-from-supabase-status
# E2E_PASSWORD=any-throwaway-value
# E2E_BASE_URL=http://localhost:4173

# Server-side secrets (service role, ZATCA, email / WhatsApp providers, cron secrets) are NOT set here.
# They are Edge Function secrets: see supabase/functions/.env.example and README -> "Edge Functions and secrets".
