# =====================================================================
# Edge Function secrets: server-side only, never in the browser, never committed.
# Production: supabase secrets set NAME=value   (or Dashboard -> Edge Functions -> Secrets)
# Local:      copy to supabase/functions/.env (git-ignored) and run supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to deployed functions automatically.
# =====================================================================

# all functions: browser origins allowed to call them (CORS). Default: https://ksa-mep-crm.vercel.app
ALLOWED_ORIGINS=

# zatca: 32 random bytes, base64 (openssl rand -base64 32). Encrypts EGS private keys and CSIDs at rest.
# Changing it makes stored CSIDs unreadable: re-onboard the EGS unit after a rotation.
ZATCA_ENC_KEY=
# zatca: long random string (openssl rand -hex 32); same value in Vault as zatca_cron_secret
ZATCA_CRON_SECRET=

# notify: long random string (openssl rand -hex 32); same value in Vault as notify_cron_secret
NOTIFY_CRON_SECRET=

# notify: email (resend | sendgrid) - leave the provider empty for dry runs only
NOTIFY_EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_REPLY_TO=

# notify: WhatsApp (meta | twilio)
NOTIFY_WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_OVERDUE=
WHATSAPP_TEMPLATE_DIGEST=
WHATSAPP_TEMPLATE_LANG=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_OVERDUE=
TWILIO_CONTENT_SID_DIGEST=
